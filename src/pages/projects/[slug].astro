---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ContactBand from '../../components/ContactBand.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import MapTile from '../../components/MapTile.astro';
import { projects, type Project } from '../../data/projects';
import { site, whatsapp } from '../../site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Project };
const label = p.sample ? `${p.type} sample project` : p.name;
const waText = `Namaste, I am interested in ${p.sample ? `your ${p.type.toLowerCase()} project` : p.name}.`;
const wa = whatsapp(waText);
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Projects', item: `${site.url}/projects` },
    { '@type': 'ListItem', position: 2, name: label, item: `${site.url}/projects/${p.slug}` },
  ],
};
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(p.mapQuery)}`;
---
<Base
  title={`${label} | Sankat Mochan Builders & Developers`}
  description={`${p.summary} ${p.type} project in ${p.city}. Status: ${p.status}. RERA number, location and enquiries on one page.`}
  waText={waText}
>
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  {p.sample && (
    <p class="sample-note">Sample layout. Every detail on this page is a placeholder until this project is registered.</p>
  )}

  <nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/projects">Projects</a> <span aria-hidden="true">/</span> <span aria-current="page">{p.name}</span></nav>

  <!-- Opening -->
  <section class="d-hero grid" aria-labelledby="d-title">
    <div class="d-hero-text" data-rise>
      <h1 id="d-title">{p.name}</h1>
      <p class="d-meta">{p.type} · {p.city} · {p.status}</p>
      <p>{p.summary}</p>
      <div class="d-actions">
        <a class="btn btn-ink" href="#enquire">Enquire</a>
        <a class="btn btn-quiet" href={wa}><Icon name="whatsapp" />WhatsApp us</a>
      </div>
    </div>
    <figure class="d-hero-pic">
      <div class="photo" data-shutter><img src={p.hero.src} width={p.hero.w} height={p.hero.h} alt={p.hero.alt} /></div>
      <figcaption class="cap">Representative image</figcaption>
    </figure>
  </section>

  <!-- Key facts -->
  <section class="d-facts grid" aria-labelledby="facts-title">
    <h2 id="facts-title" data-rise>Key facts</h2>
    <dl class="facts" data-rise style="--d:80ms">
      <div><dt>Type</dt><dd>{p.type}</dd></div>
      <div><dt>City</dt><dd>{p.city}</dd></div>
      <div><dt>Status</dt><dd>{p.status}</dd></div>
      {p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      <div class="fact-rera"><dt>RERA registration</dt><dd><a class="link" href={p.reraUrl}>{p.rera}</a></dd></div>
    </dl>
  </section>

  <!-- Overview and amenities, beside two photographs -->
  <section class="d-over grid" aria-labelledby="over-title">
    <div class="d-over-text" data-rise>
      <h2 id="over-title">About the project</h2>
      <p>{p.overview}</p>
      <h3>What is included</h3>
      <ul class="amen">{p.amenities.map((a) => <li>{a}</li>)}</ul>
    </div>
    {p.gallery.slice(0, 1).map((g, i) => (
      <figure class={`d-gal d-gal-${i + 1} photo`} data-shutter style={`--d:${i * 120}ms`}>
        <img src={g.src} width={g.w} height={g.h} alt={g.alt} loading="lazy" />
      </figure>
    ))}
  </section>

  <!-- Location -->
  <section class="d-map grid" aria-labelledby="map-title">
    <div class="d-map-text" data-rise>
      <h2 id="map-title">Location</h2>
      <p>{p.city}. The exact pin is added once the project is announced.</p>
      <a class="link" href={directions} target="_blank" rel="noopener">Get directions</a>
    </div>
    <MapTile class="d-map-tile" query={p.mapQuery} title="Project location map" />
  </section>

  <!-- Construction progress -->
  <section class="d-prog grid" aria-labelledby="prog-title">
    <h2 id="prog-title" data-rise>Construction progress</h2>
    <p class="d-prog-intro" data-rise>Dated photographs from the site, added at every stage.</p>
    <ol class="prog">
      {p.progress.map((s, i) => (
        <li data-rise style={`--d:${i * 90}ms`}>
          <div class="photo"><img src={s.photo.src} width={s.photo.w} height={s.photo.h} alt={s.photo.alt} loading="lazy" /></div>
          <p class="prog-date">{s.date}</p>
          <p>{s.note}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Brochure and enquiry -->
  <section class="d-enq grid" id="enquire" aria-labelledby="enq-title">
    <div class="d-enq-text" data-rise>
      <h2 id="enq-title">Ask about this project</h2>
      {p.brochure
        ? <a class="btn btn-ink" href={p.brochure} download><Icon name="arrow" />Download the brochure</a>
        : <p>The brochure is being prepared. Ask on WhatsApp and we will send it to you as soon as it is ready.</p>}
    </div>
    <div class="d-enq-form"><EnquiryForm service={label} extra={p.extra} /></div>
  </section>

  <ContactBand waText={waText} />
</Base>


<style>
  h2 { font-size: var(--step-heading); }
  .sample-note { margin: 0 var(--margin) 8px; padding: 12px 16px; background: var(--stone-2); font-size: var(--step-small); font-weight: 500; }
  .crumbs { padding: 8px var(--margin) 0; font-size: var(--step-small); color: var(--muted); }

  .d-hero { padding-block: clamp(24px, 5vh, 56px) var(--section-gap); align-items: center; row-gap: 40px; }
  .d-hero-text { grid-column: 1 / 6; display: grid; gap: 16px; justify-items: start; }
  .d-hero-text h1 { font-size: clamp(2.5rem, 4.4vw, 4.5rem); line-height: .95; letter-spacing: -.02em; }
  .d-meta { font-size: var(--step-lead); line-height: 1.3; }
  .d-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .d-hero-pic { grid-column: 7 / 13; margin-right: calc(-1 * var(--margin)); }
  .d-hero-pic .photo { height: min(72svh, 740px); }
  .d-hero-pic .cap { padding-right: var(--margin); }

  .d-facts { padding-bottom: var(--section-gap); row-gap: 40px; align-items: start; }
  .d-facts h2 { grid-column: 1 / 5; }
  .facts { grid-column: 5 / 13; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
  .facts div { background: var(--stone-2); padding: 18px 20px; min-width: 0; }
  .facts dt { font-size: var(--step-small); color: var(--muted); }
  .facts dd { margin: 6px 0 0; font-weight: 500; font-size: 1.125rem; overflow-wrap: anywhere; }
  .fact-rera { grid-column: span 2; background: var(--ink) !important; color: var(--stone); }
  .fact-rera dt { color: var(--stone-3); }

  .d-over { padding-bottom: clamp(80px, 9vw, 140px); align-items: center; row-gap: 0; }
  .d-over-text { grid-column: 1 / 6; display: grid; gap: 16px; }
  .d-over-text p { max-width: 48ch; }
  .d-over-text h3 { margin-top: 24px; font-size: 1.375rem; }
  .amen { display: grid; grid-template-columns: 1fr 1fr; gap: 10px var(--gutter); }
  .amen li { padding-left: 18px; position: relative; }
  .amen li::before { content: ""; position: absolute; left: 0; top: .62em; width: 8px; height: 8px; background: var(--forest); }
  .d-gal-1 { grid-column: 7 / 13; grid-row: 1; aspect-ratio: 4 / 3; margin-right: calc(-1 * var(--margin)); }
  .d-gal-2 { grid-column: 9 / 13; grid-row: 2; aspect-ratio: 1; margin-top: var(--gutter); }

  .d-map { background: var(--stone-2); padding-block: clamp(80px, 9vw, 140px); row-gap: 32px; align-items: center; }
  .d-map :global(.d-map-tile) { grid-column: 6 / 13; }
  .d-map-text { grid-column: 1 / 5; display: grid; gap: 16px; justify-items: start; }

  .d-prog { padding-block: clamp(80px, 9vw, 140px); row-gap: 24px; }
  .d-prog h2, .d-prog-intro { grid-column: 1 / -1; }
  .prog { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--gutter); margin-top: 24px; }
  .prog .photo { aspect-ratio: 4 / 3; }
  .prog-date { margin-top: 12px; font-weight: 500; }

  .d-enq { background: var(--stone-2); padding-block: clamp(80px, 9vw, 140px); row-gap: 40px; align-items: start; scroll-margin-top: 16px; }
  .d-enq-text { grid-column: 1 / 5; display: grid; gap: 20px; justify-items: start; }
  .d-enq-text p { max-width: 34ch; }
  .d-enq-form { grid-column: 6 / 13; }

  @media (max-width: 1024px) {
    .d-facts h2, .facts, .d-enq-text, .d-enq-form, .d-map-text, .d-map :global(.d-map-tile) { grid-column: 1 / -1; }
    .facts { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .d-hero-text, .d-hero-pic { grid-column: 1 / -1; }
    .d-hero-pic { grid-column: 2 / -1; }
    .d-hero-pic .photo { height: auto; aspect-ratio: 4 / 5; }
    .d-hero-text h1 { font-size: 11vw; }
    .fact-rera { grid-column: 1 / -1; }
    .d-over-text, .d-gal-1, .d-gal-2 { grid-column: 1 / -1; grid-row: auto; }
    .d-gal-1 { margin-top: 40px; margin-right: calc(-1 * var(--margin)); }
    .d-gal-2 { grid-column: 4 / -1; }
    .amen { grid-template-columns: 1fr; }
    .prog { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
