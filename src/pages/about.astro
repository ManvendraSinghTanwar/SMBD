---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import { site, whatsapp } from '../site';

const [lead, second] = site.partners;

const partners = [
  { ...lead, initials: 'DT', bio: '[PLACEHOLDER: two or three lines on D. S. Tanwar\'s background, years in land and construction, and what they look after in the company.]' },
  { ...second, initials: '', bio: '[PLACEHOLDER: two or three lines on the second partner\'s background and what they look after in the company.]' },
];

const commitments = [
  { name: 'Every project shows its RERA number', say: 'We advertise a project only once it is registered, and the number links to the state RERA website so you can check it yourself.' },
  { name: 'Costs agreed in writing', say: 'You get an itemised estimate before work begins. Any change is written down and agreed before it happens.' },
  { name: 'Progress you can see', say: 'Dated site photographs at every stage, so you can follow the build from anywhere, including from abroad.' },
  { name: 'One person to call', say: 'One of the partners stays your contact from the first site visit to the day you get the keys.' },
];

const record = [
  { label: 'RERA registration', value: site.rera },
  { label: 'GSTIN', value: '[PLACEHOLDER: GSTIN]' },
  { label: 'Firm or company registration', value: '[PLACEHOLDER: registration no.]' },
  { label: 'Registered office', value: `${site.address}, ${site.city}` },
];
---
<Base
  title="About us | Sankat Mochan Builders & Developers"
  description="Sankat Mochan Builders & Developers is a new real estate and construction company run by two partners. Meet them and read what we commit to."
>
  <!-- Opening: who we are, beside one tall photograph -->
  <section class="a-hero grid" aria-labelledby="about-title">
    <div class="a-hero-text" data-rise>
      <h1 id="about-title"><span>A new name,</span> <span>built to last</span></h1>
      <p class="a-lead">Sankat Mochan Builders &amp; Developers is a new real estate and construction company run by two partners.</p>
      <p>We build homes, commercial spaces and plotted land, and we build on land you already own. We are at the start, so this page is about how we intend to work rather than what we have done.</p>
      <a class="btn btn-ink" href={whatsapp('Namaste, I would like to meet the partners.')}><Icon name="whatsapp" />Meet the partners</a>
    </div>
    <figure class="a-hero-pic">
      <div class="photo" data-shutter><img src="/img/formwork-1600.jpg" width="1600" height="1200" alt="Representative image: walls rising in formwork on a building site" style="object-position: 35% 50%" /></div>
      <figcaption class="cap">Construction · representative image</figcaption>
    </figure>
    <figure class="a-hero-small photo" data-shutter style="--d:160ms">
      <img src="/img/plot-800.jpg" width="800" height="538" alt="Representative image: a staked plot of land" loading="lazy" style="object-position: 90% 60%" />
    </figure>
  </section>

  <!-- The name and what it asks of us -->
  <section class="a-name grid" aria-labelledby="name-title">
    <div class="a-name-text" data-rise>
      <h2 id="name-title">Why Sankat Mochan</h2>
      <p class="a-lead">Sankat Mochan means the one who frees you from trouble.</p>
      <p>Buying land and building on it brings plenty of trouble: unclear titles, missing approvals, budgets that drift and sites nobody visits. Taking that trouble off your hands is the job, and the name is there to remind us of it.</p>
    </div>
    <img class="a-name-mark" src="/brand/sm-lockup-forest.svg" alt="Sankat Mochan Builders & Developers logo" width="768" height="413" loading="lazy" data-rise style="--d:120ms" />
  </section>

  <!-- The two partners -->
  <section class="a-people grid" aria-labelledby="people-title">
    <h2 id="people-title" data-rise>The partners</h2>
    {partners.map((p, i) => (
      <figure class={`person person-${i + 1}`} data-rise style={`--d:${i * 100}ms`}>
        <div class="person-pic" aria-hidden="true">
          <span class="person-initials">{p.initials || '?'}</span>
          <span class="person-ph">[PLACEHOLDER: portrait, 4:5]</span>
        </div>
        <figcaption>
          <span class="person-name">{p.name}</span>
          <span class="person-role">{p.role}</span>
          <span class="person-bio">{p.bio}</span>
        </figcaption>
      </figure>
    ))}
  </section>

  <!-- What we commit to -->
  <section class="a-promise grid" aria-labelledby="promise-title">
    <h2 id="promise-title" data-rise>What we commit to</h2>
    <ul class="a-promise-list">
      {commitments.map((c, i) => (
        <li data-rise style={`--d:${i * 70}ms`}>
          <h3>{c.name}</h3>
          <p>{c.say}</p>
        </li>
      ))}
    </ul>
    <figure class="a-promise-pic">
      <div class="photo" data-shutter><img src="/img/villa-1600.jpg" width="1600" height="1067" alt="Representative image: a finished modern villa at dusk" loading="lazy" /></div>
      <figcaption class="cap">Residential · representative image</figcaption>
    </figure>
  </section>

  <!-- On record -->
  <section class="a-record grid" aria-labelledby="record-title">
    <div class="a-record-text" data-rise>
      <h2 id="record-title">On record</h2>
      <p>Our registrations, as they are issued. Ask us for a copy of any of them.</p>
    </div>
    <dl class="a-record-list" data-rise style="--d:100ms">
      {record.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
    </dl>
  </section>

  <ContactBand line="Want to meet the partners? Visit the office or call, and we will walk you through what we are planning." waText="Namaste, I would like to meet the partners." />
</Base>

<style>
  h2 { font-size: var(--step-heading); }
  .a-lead { font-size: var(--step-lead); line-height: 1.3; }

  /* Opening */
  .a-hero { padding-block: clamp(24px, 6vh, 64px) var(--section-gap); row-gap: 0; align-items: start; }
  .a-hero-text { grid-column: 1 / 6; grid-row: 1; display: grid; gap: 20px; justify-items: start; padding-top: 4vh; }
  .a-hero-text h1 { font-size: clamp(2.5rem, 4.4vw, 4.5rem); line-height: .95; letter-spacing: -.02em; }
  .a-hero-text h1 span { display: block; }
  .a-hero-text p { max-width: 44ch; }
  .a-hero-text .a-lead { max-width: 30ch; }
  .a-hero-pic { grid-column: 7 / 13; grid-row: 1 / 3; margin-right: calc(-1 * var(--margin)); }
  .a-hero-pic .photo { height: min(84svh, 860px); }
  .a-hero-pic .cap { padding-right: var(--margin); }
  .a-hero-small { grid-column: 1 / 4; grid-row: 2; aspect-ratio: 1; margin-top: 64px; max-width: 260px; }

  /* The name */
  .a-name { background: var(--stone-2); padding-block: clamp(96px, 10vw, 160px); align-items: center; row-gap: 48px; }
  .a-name-text { grid-column: 1 / 7; display: grid; gap: 20px; }
  .a-name-text p { max-width: 48ch; }
  .a-name-mark { grid-column: 8 / 13; width: 100%; }

  /* Partners */
  .a-people { padding-block: var(--section-gap) 0; row-gap: 0; align-items: start; }
  .a-people h2 { grid-column: 1 / -1; margin-bottom: 64px; }
  .person-1 { grid-column: 1 / 6; }
  .person-2 { grid-column: 8 / 13; margin-top: 160px; }
  .person-pic { position: relative; aspect-ratio: 4 / 5; background: var(--stone-2); display: grid; place-items: center; }
  .person-initials { font-family: var(--font-display); font-weight: 600; font-size: clamp(5rem, 10vw, 9rem); color: var(--forest); letter-spacing: -.03em; }
  .person-ph { position: absolute; left: 16px; bottom: 14px; font-size: var(--step-small); color: var(--muted); }
  .person figcaption { display: grid; gap: 4px; margin-top: 20px; max-width: 46ch; }
  .person-name { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; line-height: 1.1; }
  .person-role { color: var(--muted); }
  .person-bio { margin-top: 8px; }

  /* Commitments */
  .a-promise { padding-block: var(--section-gap); row-gap: 0; align-items: start; }
  .a-promise h2 { grid-column: 1 / 7; margin-bottom: 56px; }
  .a-promise-list { grid-column: 1 / 7; grid-row: 2; display: grid; gap: 40px; }
  .a-promise-list h3 { font-size: var(--step-lead); line-height: 1.15; }
  .a-promise-list p { margin-top: 8px; max-width: 48ch; }
  .a-promise-pic { grid-column: 8 / 13; grid-row: 1 / 3; margin-top: 24px; position: sticky; top: 24px; }
  .a-promise-pic .photo { aspect-ratio: 4 / 5; }

  /* On record */
  .a-record { background: var(--stone-2); padding-block: clamp(80px, 9vw, 140px); align-items: start; row-gap: 40px; }
  .a-record-text { grid-column: 1 / 6; display: grid; gap: 16px; }
  .a-record-text p { max-width: 36ch; }
  .a-record-list { grid-column: 7 / 13; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .a-record-list div { background: var(--stone); padding: 20px; min-width: 0; }
  .a-record-list dt { font-size: var(--step-small); color: var(--muted); }
  .a-record-list dd { margin: 6px 0 0; font-weight: 500; overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    .a-hero-text, .a-hero-pic { grid-column: 1 / -1; grid-row: auto; }
    .a-hero-text { padding-top: 0; }
    .a-hero { padding-bottom: 72px; }
    .a-hero-text h1 { font-size: 11vw; }
    .a-hero-pic { margin: 48px calc(-1 * var(--margin)) 0 0; grid-column: 2 / -1; }
    .a-hero-pic .photo { height: auto; aspect-ratio: 4 / 5; }
    .a-hero-pic .cap { display: none; }
    .a-hero-small { grid-column: 1 / 7; grid-row: auto; margin-top: -48px; position: relative; }

    .a-name-text, .a-name-mark { grid-column: 1 / -1; }
    .a-name-mark { width: 80%; }

    .a-people h2 { margin-bottom: 40px; }
    .person-1 { grid-column: 1 / 11; }
    .person-2 { grid-column: 3 / -1; margin-top: 64px; }

    .a-promise h2, .a-promise-list, .a-promise-pic { grid-column: 1 / -1; grid-row: auto; }
    .a-promise h2 { margin-bottom: 40px; }
    .a-promise-pic { position: static; margin-top: 56px; }
    .a-promise-pic .photo { aspect-ratio: 4 / 3; }

    .a-record-text, .a-record-list { grid-column: 1 / -1; }
    .a-record-list { grid-template-columns: 1fr; }
  }
</style>
