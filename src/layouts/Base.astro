---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, whatsapp, nav, services, credits } from '../site';

interface Props { title: string; description: string; waText?: string }
const { title, description, waText } = Astro.props;
const wa = whatsapp(waText);
const year = new Date().getFullYear();

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'GeneralContractor'],
  name: site.name,
  slogan: site.tagline,
  telephone: '+91-77376-33333',
  email: site.email,
  url: site.url,
  logo: `${site.url}/brand/sm-lockup-forest.svg`,
  founder: site.partners.map((p) => ({ '@type': 'Person', name: p.name })),
};
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#17382B" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar on-forest">
    <a class="bar-mark" href="/" aria-label="Sankat Mochan Builders & Developers, home">
      <img src="/brand/sm-emblem-champagne.svg" alt="" width="62" height="24" />
      <span class="bar-name" aria-hidden="true">
        <svg class="bar-name-1" viewBox="136 856 753 61"><use href="/brand/sm-name.svg#p" /></svg>
        <svg class="bar-name-2" viewBox="198 941 628 24"><use href="/brand/sm-descriptor.svg#p" /></svg>
      </span>
    </a>
    <nav class="bar-nav" aria-label="Main">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-gold bar-action" href={wa}><Icon name="whatsapp" />WhatsApp us</a>
    <button class="bar-menu" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <Icon name="menu" />
    </button>
  </header>

  <div class="menu" id="menu" hidden>
    <button class="menu-close" type="button" aria-label="Close menu"><Icon name="close" /></button>
    <nav aria-label="Menu">
      <a href="/">Home</a>
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-ink" href={site.phoneHref}><Icon name="phone" />Call {site.phoneDisplay}</a>
  </div>

  <main id="main"><slot /></main>

  <footer class="foot on-forest">
    <div class="foot-cols">
      <div>
        <p class="foot-head">Office</p>
        <p>{site.address}</p>
        <p>{site.city}</p>
        <p>{site.hours}</p>
      </div>
      <div>
        <p class="foot-head">What we build</p>
        <ul>{services.map((s) => <li><a class="link" href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <div>
        <p class="foot-head">Talk to us</p>
        <ul>
          <li><a class="link" href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li><a class="link" href={wa}>WhatsApp</a></li>
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div>
        <p class="foot-head">On record</p>
        <ul>
          <li>{site.rera}</li>
          <li><a class="link" href="/privacy">Privacy policy</a></li>
          <li><a class="link" href="/disclaimer">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-name">
      <svg viewBox="136 856 753 61" role="img" aria-label="Sankat Mochan"><use href="/brand/sm-name.svg#p" /></svg>
      <p class="foot-legal">© {year} {site.name}. {site.tagline}.</p>
      <p class="foot-legal">Photographs on this site are representative images, not our projects. Credits: {credits.join(' · ')}.</p>
    </div>
  </footer>

  <!-- Always-on contact: bottom bar on phones -->
  <nav class="dock" aria-label="Quick contact">
    <a href={site.phoneHref}><Icon name="phone" />Call</a>
    <a href={wa}><Icon name="whatsapp" />WhatsApp</a>
    <a href="/contact"><Icon name="mail" />Enquire</a>
  </nav>

  <script>
    // Mobile menu: open, close, Escape, focus return and a simple focus trap
    const btn = document.querySelector<HTMLButtonElement>('.bar-menu')!;
    const menu = document.getElementById('menu')!;
    const close = menu.querySelector<HTMLButtonElement>('.menu-close')!;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      (open ? close : btn).focus();
    };
    btn.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
      if (e.key !== 'Tab') return;
      const f = [...menu.querySelectorAll<HTMLElement>('a, button')];
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // Entrances and shutters, once per element
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px' });
    document.querySelectorAll('[data-rise], [data-shutter]').forEach((el) => io.observe(el));
  </script>

  <style>
    .bar {
      position: relative; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      padding: 18px var(--margin); margin-bottom: clamp(16px, 2vw, 28px);
      background: var(--forest); color: var(--on-forest);
    }
    .bar-mark { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; justify-self: start; }
    /* The emblem is as tall as the two lines of lettering beside it */
    .bar-mark { --name-w: 200px; --gap: 6px; }
    .bar-mark img { width: auto; height: calc(var(--name-w) * 61 / 753 + var(--gap) + var(--name-w) * 24 / 628); }
    .bar-name { display: grid; gap: var(--gap); width: var(--name-w); }
    .bar-name svg { width: 100%; height: auto; }
    .bar-name-1 { fill: var(--champ); }
    .bar-name-2 { fill: var(--on-forest); }
    .bar-nav { display: flex; gap: 32px; font-size: var(--step-small); font-weight: 500; }
    .bar-nav a { text-decoration: none; padding: 10px 0; transition: color var(--dur) var(--ease); }
    .bar-nav a:hover { color: var(--champ); text-decoration: underline; }
    .bar-action { justify-self: end; min-height: 44px; padding: 0 18px; font-size: 1rem; }
    .bar-menu { display: none; justify-self: end; background: none; border: 0; color: var(--on-forest); width: 48px; height: 48px; padding: 12px; cursor: pointer; }

    .menu { position: fixed; inset: 0; z-index: 60; background: var(--stone); display: flex; flex-direction: column; gap: 32px; padding: 88px var(--margin) 40px; }
    .menu[hidden] { display: none; }
    .menu nav { display: flex; flex-direction: column; }
    .menu nav a { font-family: var(--font-display); font-weight: 600; font-size: 2.5rem; line-height: 1.25; text-decoration: none; }
    .menu-close { position: absolute; top: 16px; right: var(--margin); width: 48px; height: 48px; padding: 12px; background: none; border: 0; cursor: pointer; }
    .menu .btn { align-self: flex-start; }

    .foot {
      min-height: 90svh; display: grid; grid-template-rows: auto 1fr auto;
      background: var(--forest-3); color: var(--on-forest);
      padding: 64px var(--margin) 28px; font-size: var(--step-small);
    }
    .foot-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
    .foot-cols > div { display: grid; gap: 4px; align-content: start; color: var(--soft-on-forest); }
    .foot-cols ul { display: grid; gap: 4px; }
    .foot-head { color: var(--on-forest); font-weight: 500; margin-bottom: 6px; }
    .foot-name { grid-row: 3; padding-top: 96px; }
    .foot-name svg { width: 100%; height: auto; fill: var(--champ); }
    .foot-legal { max-width: 75ch; margin-top: 16px; font-size: var(--step-small); color: var(--soft-on-forest); }
    .foot-legal + .foot-legal { margin-top: 6px; }

    .dock { display: none; }

    @media (max-width: 860px) {
      .bar { grid-template-columns: 1fr auto; padding-block: 12px; }
      .bar-nav, .bar-action { display: none; }
      .bar-menu { display: block; }
      .foot-cols { grid-template-columns: 1fr 1fr; row-gap: 32px; }
      .foot { padding-bottom: calc(84px + env(safe-area-inset-bottom)); }
      .dock {
        display: grid; grid-template-columns: repeat(3, 1fr);
        position: fixed; inset: auto 0 0 0; z-index: 40;
        background: var(--ink); padding-bottom: env(safe-area-inset-bottom);
      }
      .dock a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 56px; text-decoration: none; font-weight: 500; font-size: var(--step-small); color: var(--stone); }
      .dock a:nth-child(2) { background: var(--forest); }
      .dock :global(svg) { width: 20px; height: 20px; }
    }
    @media (max-width: 380px) {
      .bar-mark { --name-w: 168px; --gap: 5px; }
    }
  </style>
</body>
</html>
